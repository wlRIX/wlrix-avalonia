<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wlrix.Demo"
             xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
             x:Class="Wlrix.Demo.App"
             RequestedThemeVariant="Default">

    <!-- No scheme dictionary here on purpose. Application.Resources is consulted *before* a
         style's own resources, so merging a scheme here would shadow the one WlrixTheme holds
         and WlrixTheme.Scheme would appear to do nothing. The theme carries the default and
         swaps it in place. -->

    <Application.Styles>
        <wlrix:WlrixTheme />
        <wlrix:ColorPickerTheme />
    </Application.Styles>
</Application>
