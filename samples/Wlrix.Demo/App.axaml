<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wlrix.Demo"
             xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
             x:Class="Wlrix.Demo.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active color scheme. Swapped at runtime by the scheme switcher. -->
                <ResourceInclude Source="avares://Wlrix.Avalonia/Schemes/Classic.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <wlrix:WlrixTheme />
        <wlrix:ColorPickerTheme />
    </Application.Styles>
</Application>
