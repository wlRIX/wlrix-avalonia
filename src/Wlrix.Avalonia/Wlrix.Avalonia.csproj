<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / ImplicitUsings / Nullable come from Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>Wlrix.Avalonia</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- NuGet packaging metadata (theme is meant to be consumed as a package). -->
    <PackageId>Wlrix.Avalonia</PackageId>
    <!-- Bump on every localfeed rebuild: NuGet caches by id+version, so republishing a version
         means the cached copy is served and the new bits are silently ignored. -->
    <Version>0.0.3</Version>
    <Authors>wlRIX contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Avalonia control theme for wlRIX: chiselled bevels, hard outlines, and the wlRIX Classic palette.</Description>
    <RepositoryUrl>https://github.com/wlrix/wlrix-avalonia</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

</Project>
