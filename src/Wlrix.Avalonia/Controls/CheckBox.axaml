<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia">

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <!-- A small raised square that sinks in when checked -->
                    <wlrix:BevelBorder Name="Box"
                                     Grid.Column="0"
                                     Width="15"
                                     Height="15"
                                     VerticalAlignment="Center"
                                     Bevel="Raised"
                                     BevelThickness="2"
                                     OuterLineThickness="1"
                                     Background="{DynamicResource WlrixFace}"
                                     LightBrush="{DynamicResource WlrixTopShadow}"
                                     DarkBrush="{DynamicResource WlrixBottomShadow}"
                                     OuterLineBrush="{DynamicResource WlrixOuterLine}">
                        <Border Name="Mark"
                                Background="{DynamicResource WlrixCheck}"
                                Margin="1"
                                IsVisible="False" />
                    </wlrix:BevelBorder>

                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ wlrix|BevelBorder#Box">
            <Setter Property="Bevel" Value="Sunken" />
            <Setter Property="Background" Value="{DynamicResource WlrixSelect}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Mark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ wlrix|BevelBorder#Box">
            <Setter Property="Bevel" Value="Sunken" />
        </Style>
        <Style Selector="^:indeterminate /template/ Border#Mark">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="{DynamicResource WlrixBottomShadow}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource WlrixDisabledForeground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
