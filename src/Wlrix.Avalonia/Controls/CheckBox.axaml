<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia">

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <!-- A small raised square. It stays raised when checked, as IRIX's did, and
                         its face lightens under the pointer and while checked, which is what
                         lets the red check stand out. -->
                    <wlrix:BevelBorder Name="Box"
                                     Grid.Column="0"
                                     Width="15"
                                     Height="15"
                                     VerticalAlignment="Center"
                                     Bevel="Raised"
                                     BevelThickness="2"
                                     OuterLineThickness="1"
                                     Background="{DynamicResource WlrixFace}"
                                     LightBrush="{DynamicResource WlrixTopShadow}"
                                     DarkBrush="{DynamicResource WlrixBottomShadow}"
                                     OuterLineBrush="{DynamicResource WlrixOuterLine}">
                        <!-- The indeterminate state only. IRIX had no third state, so it keeps
                             the plain filled square rather than borrowing the check. -->
                        <Border Name="Mark"
                                Background="{DynamicResource WlrixBottomShadow}"
                                Margin="1"
                                IsVisible="False" />
                    </wlrix:BevelBorder>

                    <!-- IRIX's red check, from _docs/svg-icons/check.svg scaled to the box.
                         Drawn over the box rather than inside it, because the long stroke's
                         tip runs out past the top-right corner, as it did in IRIX. The black
                         line under the long stroke is IRIX's drop shadow; the art outlines the
                         whole mark, and at this size that reads as a black blob with a red
                         middle. The art is flattened a little and its red edged by a pixel to
                         match IRIX's bolder mark, and the shadow runs on round the
                         short stroke's tip so the red edge does not show beneath it. Aliased because IRIX's check was
                         pixel art: smoothed, it goes soft at this size. -->
                    <Canvas Name="Check"
                            Grid.Column="0"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            RenderOptions.EdgeMode="Aliased"
                            IsVisible="False">
                        <Path Data="M4.49,5.51 L6.31,6.13 L7.22,6.62 L9.33,8.44 L9.48,9.77 L7.36,11.22 L6.71,9.68 L6.14,8.93 L5.11,8.49 L4.10,8.29 L2.99,8.21 L1.50,8.33 Z"
                              Classes="Mark" />
                        <Path Data="M7.68,7.01 L8.29,6.42 L9.51,5.39 L10.64,4.63 L12.08,3.74 L15.99,1.50 L15.03,3.57 L12.29,5.55 L10.76,6.67 L9.38,8.37 L8.09,10.09 Z"
                              Classes="Mark" />
                        <Path Data="M15.03,3.57 L12.29,5.55 L10.76,6.67 L9.38,8.37 L9.48,9.77 L7.35,11.21 L6.60,12.20"
                              Stroke="{DynamicResource WlrixOuterLine}"
                              StrokeThickness="1" />
                    </Canvas>

                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ wlrix|BevelBorder#Box">
            <Setter Property="Background" Value="{DynamicResource WlrixTopShadow}" />
            <Setter Property="LightBrush" Value="{DynamicResource WlrixCheckBoxLitEdge}" />
        </Style>
        <Style Selector="^:checked /template/ wlrix|BevelBorder#Box">
            <Setter Property="Background" Value="{DynamicResource WlrixTopShadow}" />
            <Setter Property="LightBrush" Value="{DynamicResource WlrixCheckBoxLitEdge}" />
        </Style>
        <Style Selector="^:checked /template/ Canvas#Check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ wlrix|BevelBorder#Box">
            <Setter Property="Bevel" Value="Sunken" />
        </Style>
        <Style Selector="^:indeterminate /template/ Border#Mark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource WlrixDisabledForeground}" />
        </Style>
        <!-- The check's red, set here rather than on the paths so the disabled state can
             replace it: a value written on the element itself would win over any style. -->
        <Style Selector="^ /template/ Canvas#Check > Path.Mark">
            <Setter Property="Fill" Value="{DynamicResource WlrixCheck}" />
            <Setter Property="Stroke" Value="{DynamicResource WlrixCheck}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <!-- The scheme's faded red, so a disabled box reads as disabled, not merely checked. -->
        <Style Selector="^:disabled /template/ Canvas#Check > Path.Mark">
            <Setter Property="Fill" Value="{DynamicResource WlrixDisabledCheck}" />
            <Setter Property="Stroke" Value="{DynamicResource WlrixDisabledCheck}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
