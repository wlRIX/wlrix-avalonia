<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia">

    <conv:PlatformKeyGestureConverter x:Key="WlrixKeyGestureConverter" />

    <!-- Shared raised-bevel container for drop-down / context menu panels. -->
    <ControlTheme x:Key="WlrixMenuFlyoutPresenter" TargetType="wlrix:BevelBorder">
        <Setter Property="Bevel" Value="Raised" />
        <Setter Property="BevelThickness" Value="2" />
        <Setter Property="OuterLineThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource WlrixFace}" />
        <Setter Property="LightBrush" Value="{DynamicResource WlrixTopShadow}" />
        <Setter Property="DarkBrush" Value="{DynamicResource WlrixBottomShadow}" />
        <Setter Property="OuterLineBrush" Value="{DynamicResource WlrixOuterLine}" />
    </ControlTheme>

    <!-- =================== Top-level menu item (on the bar) =================== -->
    <ControlTheme x:Key="WlrixTopLevelMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Template">
            <ControlTemplate>
                <wlrix:BevelBorder Name="Bevel"
                                 Bevel="Raised"
                                 BevelThickness="2"
                                 Background="Transparent"
                                 LightBrush="Transparent"
                                 DarkBrush="Transparent">
                    <Panel>
                        <ContentPresenter Name="PART_HeaderPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="x:String">
                                    <AccessText Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>

                        <Popup Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               Placement="BottomEdgeAlignedLeft"
                               IsLightDismissEnabled="True"
                               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                            <wlrix:BevelBorder Theme="{StaticResource WlrixMenuFlyoutPresenter}" Padding="2">
                                <ScrollViewer>
                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    KeyboardNavigation.TabNavigation="Continue" />
                                </ScrollViewer>
                            </wlrix:BevelBorder>
                        </Popup>
                    </Panel>
                </wlrix:BevelBorder>
            </ControlTemplate>
        </Setter>

        <!-- Armed/selected: light up the (always-reserved) raised bevel on the menu title -->
        <Style Selector="^:selected /template/ wlrix|BevelBorder#Bevel">
            <Setter Property="Background" Value="{DynamicResource WlrixFace}" />
            <Setter Property="LightBrush" Value="{DynamicResource WlrixTopShadow}" />
            <Setter Property="DarkBrush" Value="{DynamicResource WlrixBottomShadow}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource WlrixDisabledForeground}" />
        </Style>
    </ControlTheme>

    <!-- ===================== Nested menu item (in a flyout) ==================== -->
    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The bevel is always present (so the item never changes size); its edges
                     are transparent until the item is selected, when they light up raised. -->
                <wlrix:BevelBorder Name="Root"
                                 Bevel="Raised"
                                 BevelThickness="2"
                                 Background="Transparent"
                                 LightBrush="Transparent"
                                 DarkBrush="Transparent">
                    <Grid Margin="{TemplateBinding Padding}"
                          ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <!-- Check / radio marker. IRIX menus draw the same indicators as the
                             stand-alone controls, only smaller: a raised square that lightens
                             and shows the red check for a toggle (CheckBox.axaml), and a
                             diamond that sinks and shows the radio mark for one-of-many
                             (RadioButton.axaml).
                             Both are always in the template; the :toggle / :radio styles below
                             pick one. -->
                        <ContentControl Name="PART_ToggleIconPresenter"
                                        Grid.Column="0"
                                        IsVisible="False"
                                        Width="16" Height="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center">
                            <Panel>
                                <wlrix:BevelBorder Name="ToggleBox"
                                                 Width="13" Height="13"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsVisible="False"
                                                 Bevel="Raised"
                                                 BevelThickness="2"
                                                 OuterLineThickness="1"
                                                 Background="{DynamicResource WlrixFace}"
                                                 LightBrush="{DynamicResource WlrixTopShadow}"
                                                 DarkBrush="{DynamicResource WlrixBottomShadow}"
                                                 OuterLineBrush="{DynamicResource WlrixOuterLine}" />
                                <!-- CheckBox.axaml's check, scaled from its 15px box to this
                                     13px one; at 11px it blurred into a smear. Over the box, unclipped, so the tip overhangs the
                                     corner as it does there. -->
                                <Canvas Name="ToggleCheck"
                                        Width="13" Height="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderOptions.EdgeMode="Aliased"
                                        IsVisible="False">
                                    <Path Data="M3.89,4.78 L5.47,5.31 L6.26,5.74 L8.09,7.31 L8.22,8.47 L6.38,9.72 L5.82,8.39 L5.32,7.74 L4.43,7.36 L3.55,7.19 L2.60,7.12 L1.30,7.22 Z"
                                          Classes="Mark" />
                                    <Path Data="M6.66,6.07 L7.18,5.56 L8.24,4.67 L9.22,4.01 L10.47,3.24 L13.85,1.30 L13.03,3.09 L10.65,4.81 L9.32,5.79 L8.13,7.25 L7.01,8.74 Z"
                                          Classes="Mark" />
                                    <Path Data="M13.03,3.09 L10.65,4.81 L9.32,5.79 L8.13,7.25 L8.22,8.47 L6.37,9.72 L6.08,10.03"
                                          Stroke="{DynamicResource WlrixOuterLine}"
                                          StrokeThickness="1" />
                                </Canvas>
                                <wlrix:BevelBorder Name="RadioBox"
                                                 Width="10" Height="10"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 RenderTransform="rotate(45deg)"
                                                 IsVisible="False"
                                                 Bevel="Raised"
                                                 BevelThickness="2"
                                                 OuterLineThickness="1"
                                                 Background="{DynamicResource WlrixFace}"
                                                 LightBrush="{DynamicResource WlrixTopShadow}"
                                                 DarkBrush="{DynamicResource WlrixBottomShadow}"
                                                 OuterLineBrush="{DynamicResource WlrixOuterLine}">
                                    <Border Name="RadioMark"
                                            Background="{DynamicResource WlrixRadio}"
                                            IsVisible="False" />
                                </wlrix:BevelBorder>
                            </Panel>
                        </ContentControl>

                        <!-- Optional icon -->
                        <ContentControl Name="PART_IconPresenter"
                                        Grid.Column="1"
                                        Content="{TemplateBinding Icon}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />

                        <!-- Header -->
                        <ContentPresenter Name="PART_HeaderPresenter"
                                          Grid.Column="2"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="x:String">
                                    <AccessText Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>

                        <!-- Input gesture (shortcut) -->
                        <TextBlock Name="PART_InputGestureText"
                                   Grid.Column="3"
                                   Margin="24,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WlrixDisabledForeground}"
                                   Text="{TemplateBinding InputGesture, Converter={StaticResource WlrixKeyGestureConverter}}" />

                        <!-- Submenu chevron (hidden for leaf items via the :empty selector) -->
                        <Path Name="PART_ChevronPath"
                              Grid.Column="4"
                              Data="M 0,0 L 4,4 L 0,8 Z"
                              Fill="{DynamicResource WlrixForeground}"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center" />

                        <Popup Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               Placement="RightEdgeAlignedTop"
                               IsLightDismissEnabled="False"
                               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                            <wlrix:BevelBorder Theme="{StaticResource WlrixMenuFlyoutPresenter}" Padding="2">
                                <ScrollViewer>
                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    KeyboardNavigation.TabNavigation="Continue" />
                                </ScrollViewer>
                            </wlrix:BevelBorder>
                        </Popup>
                    </Grid>
                </wlrix:BevelBorder>
            </ControlTemplate>
        </Setter>

        <!-- Separator item: a MenuItem headed "-". The `Separator` element spelling is
             themed in Separator.axaml; keep the two looking the same. -->
        <Style Selector="^:separator">
            <Setter Property="Template">
                <ControlTemplate>
                    <wlrix:BevelBorder Bevel="Etched"
                                     BevelThickness="2"
                                     Height="2"
                                     Margin="4,3"
                                     LightBrush="{DynamicResource WlrixTopShadow}"
                                     DarkBrush="{DynamicResource WlrixBottomShadow}" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Selection lights up the raised bevel (IRIX style); the reserved edge space is
             always present so selecting an item does not change its size. -->
        <Style Selector="^:selected /template/ wlrix|BevelBorder#Root">
            <Setter Property="Background" Value="{DynamicResource WlrixFace}" />
            <Setter Property="LightBrush" Value="{DynamicResource WlrixTopShadow}" />
            <Setter Property="DarkBrush" Value="{DynamicResource WlrixBottomShadow}" />
        </Style>

        <!-- Leaf items (no submenu) hide the chevron -->
        <Style Selector="^:empty /template/ Path#PART_ChevronPath">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Toggle / radio indicators -->
        <Style Selector="^:toggle /template/ ContentControl#PART_ToggleIconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:toggle /template/ wlrix|BevelBorder#ToggleBox">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Checked stays raised with the light face, as CheckBox does. -->
        <Style Selector="^:toggle:checked /template/ wlrix|BevelBorder#ToggleBox">
            <Setter Property="Background" Value="{DynamicResource WlrixTopShadow}" />
            <Setter Property="LightBrush" Value="{DynamicResource WlrixCheckBoxLitEdge}" />
        </Style>
        <Style Selector="^:toggle:checked /template/ Canvas#ToggleCheck">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ Canvas#ToggleCheck > Path.Mark">
            <Setter Property="Fill" Value="{DynamicResource WlrixCheck}" />
            <Setter Property="Stroke" Value="{DynamicResource WlrixCheck}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Canvas#ToggleCheck > Path.Mark">
            <Setter Property="Fill" Value="{DynamicResource WlrixDisabledCheck}" />
            <Setter Property="Stroke" Value="{DynamicResource WlrixDisabledCheck}" />
        </Style>
        <Style Selector="^:radio /template/ ContentControl#PART_ToggleIconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:radio /template/ wlrix|BevelBorder#RadioBox">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:radio:checked /template/ wlrix|BevelBorder#RadioBox">
            <Setter Property="Bevel" Value="Sunken" />
            <Setter Property="Background" Value="{DynamicResource WlrixSelect}" />
        </Style>
        <Style Selector="^:radio:checked /template/ Border#RadioMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- A menu's title row (IRIX popup menus open with the name of what they act on,
             centered over an etched rule). Mark it with Classes="title"; it is drawn as a
             label, so set IsEnabled="False" or leave it without a command, and the theme
             keeps the disabled dimming off it. -->
        <Style Selector="^.title">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="Center"
                                          Margin="8,3,8,2"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource WlrixForeground}" />
                        <wlrix:BevelBorder Bevel="Etched"
                                         BevelThickness="2"
                                         Height="2"
                                         Margin="0,0,0,2"
                                         LightBrush="{DynamicResource WlrixTopShadow}"
                                         DarkBrush="{DynamicResource WlrixBottomShadow}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource WlrixDisabledForeground}" />
        </Style>
        <Style Selector="^:disabled /template/ wlrix|BevelBorder#Root">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </ControlTheme>

    <!-- ============================ Menu (the bar) ============================ -->
    <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource WlrixFace}" />
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource WlrixTopLevelMenuItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- TemplateBinding rather than the brush directly, so the Background setter
                     above is what decides and a derived theme can change it. wlrix:MenuBar
                     does exactly that; with the brush inlined here its setter did nothing. -->
                <wlrix:BevelBorder Bevel="Raised"
                                 BevelThickness="2"
                                 Background="{TemplateBinding Background}"
                                 LightBrush="{DynamicResource WlrixTopShadow}"
                                 DarkBrush="{DynamicResource WlrixBottomShadow}"
                                 Padding="2,1">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue" />
                </wlrix:BevelBorder>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============================ ContextMenu ============================== -->
    <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <wlrix:BevelBorder Theme="{StaticResource WlrixMenuFlyoutPresenter}" Padding="2">
                    <ScrollViewer>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        KeyboardNavigation.TabNavigation="Continue" />
                    </ScrollViewer>
                </wlrix:BevelBorder>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
