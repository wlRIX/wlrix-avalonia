<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia">
    <!-- IRIX tab: a rounded-trapezoid handle drawn by TabShape. Unselected tabs use the
         recessed WlrixSelect face; the selected tab uses the page color (WlrixFace) and runs
         into the page through a gap NotebookTabPanel opens in the page's edge. The panel also
         overlaps the tabs and stacks them (ZIndex). The tab clips so that a tab the panel has
         left out of the strip, arranged at zero size, draws nothing. -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <wlrix:TabShape Name="Shape"
                                  IsSelected="{TemplateBinding IsSelected}"
                                  Background="{DynamicResource WlrixSelect}"
                                  SelectedBackground="{DynamicResource WlrixFace}"
                                  LightBrush="{DynamicResource WlrixTopShadow}"
                                  DarkBrush="{DynamicResource WlrixBottomShadow}"
                                  OuterLineBrush="{DynamicResource WlrixOuterLine}"
                                  SlantWidth="10" CornerRadius="4" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Bottom strip: flip the trapezoid so its wide base meets the page above. -->
        <Style Selector="^[TabStripPlacement=Bottom] /template/ wlrix|TabShape#Shape">
            <Setter Property="FlipVertical" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource WlrixDisabledForeground}" />
        </Style>
    </ControlTheme>

    <!-- Shared by NotebookTabControl, which is styled as a TabControl. -->
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <!-- The strip. The stacks of hidden-tab edges lie behind the tabs, so the end
                         tabs overlap them; NotebookTabPanel places them and takes their clicks. -->
                    <Panel Name="PART_Strip" DockPanel.Dock="Top" Margin="4,0">
                        <wlrix:NotebookOverflowEdges Name="PART_OverflowEdges"
                                                     Background="{DynamicResource WlrixSelect}"
                                                     LightBrush="{DynamicResource WlrixTopShadow}"
                                                     DarkBrush="{DynamicResource WlrixBottomShadow}"
                                                     OuterLineBrush="{DynamicResource WlrixOuterLine}" />
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        HorizontalAlignment="Left"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Panel>
                    <!-- Page body: a raised panel. NotebookTabPanel breaks its edge under the
                         selected tab so the two read as one surface. -->
                    <wlrix:BevelBorder Name="PART_Page"
                                       Bevel="Raised" BevelThickness="2" OuterLineThickness="1"
                                       Background="{DynamicResource WlrixFace}"
                                       LightBrush="{DynamicResource WlrixTopShadow}"
                                       DarkBrush="{DynamicResource WlrixBottomShadow}"
                                       OuterLineBrush="{DynamicResource WlrixOuterLine}"
                                       Padding="8">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </wlrix:BevelBorder>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <wlrix:NotebookTabPanel />
            </ItemsPanelTemplate>
        </Setter>

        <Style Selector="^[TabStripPlacement=Top] /template/ Panel#PART_Strip">
            <Setter Property="DockPanel.Dock" Value="Top" />
        </Style>
        <Style Selector="^[TabStripPlacement=Bottom] /template/ Panel#PART_Strip">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
        </Style>
        <Style Selector="^[TabStripPlacement=Left] /template/ Panel#PART_Strip">
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right] /template/ Panel#PART_Strip">
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
