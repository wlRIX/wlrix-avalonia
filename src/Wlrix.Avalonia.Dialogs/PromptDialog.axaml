<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Wlrix.Avalonia.Dialogs.PromptDialog"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Name="Prompt" TextWrapping="Wrap" />
        <TextBox Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="Accept" Content="OK" MinWidth="80" IsDefault="True" />
            <Button Name="Reject" Content="Cancel" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
